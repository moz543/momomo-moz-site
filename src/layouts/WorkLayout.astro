---
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import ExternalLink from '../components/ExternalLink.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'works'>;
}

const { entry } = Astro.props;
const { data } = entry;
const formattedDate = data.date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
});
---
<BaseLayout
  title={`${data.title} | moz`}
  description={data.summary}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <header class="mb-8">
      <p class="text-sm uppercase tracking-wider" style="color: var(--muted)">
        {formattedDate}{data.tags.length > 0 && ' · '}{data.tags.join(' · ')}
      </p>
      <h1 class="mt-2 text-3xl font-medium tracking-tight sm:text-4xl">
        {data.title}
      </h1>
      {data.summary && (
        <p class="mt-3 text-lg" style="color: var(--muted)">{data.summary}</p>
      )}
    </header>

    {data.video && (
      <div class="mb-8">
        <VideoEmbed provider={data.video.provider} id={data.video.id} title={data.title} />
      </div>
    )}

    {!data.video && (
      <div class="mb-8 overflow-hidden rounded">
        <Image src={data.cover} alt={data.title} widths={[480, 800, 1200, 1800]} sizes="(min-width: 768px) 768px, 100vw" />
      </div>
    )}

    <div class="prose prose-neutral max-w-none dark:prose-invert">
      <slot />
    </div>

    {data.links.length > 0 && (
      <section class="mt-12 border-t pt-8" style="border-color: var(--border)">
        <h2 class="mb-4 text-sm font-medium uppercase tracking-wider" style="color: var(--muted)">
          関連リンク
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {data.links.map((link) => (
            <li><ExternalLink {...link} /></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
