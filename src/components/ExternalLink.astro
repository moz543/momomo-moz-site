---
interface Props {
  label: string;
  url: string;
  kind?: 'github' | 'drive' | 'dropbox' | 'site' | 'other';
}

const { label, url, kind = 'other' } = Astro.props;

const icon: Record<string, string> = {
  github: '◐',
  drive: '▷',
  dropbox: '◇',
  site: '↗',
  other: '→',
};
---
<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex items-center gap-3 rounded border px-4 py-3 text-sm transition-colors hover:bg-neutral-100 dark:hover:bg-neutral-900"
  style="border-color: var(--border)"
>
  <span class="font-mono opacity-60">{icon[kind]}</span>
  <span class="flex-1">{label}</span>
  <span class="text-xs opacity-40">{new URL(url).hostname}</span>
</a>
